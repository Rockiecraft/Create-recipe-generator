{
  "name": "create-recipe-generator",
  "version": "0.0.2",
  "description": "Recipe Generator for the Create Mod",
  "main": "app-entry.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage --linux flatpak",
    "dist": "electron-builder --win portable --linux AppImage --linux flatpak"
  },
  "build": {
    "directories": {
    "buildResources": "src/main/assets"
  },
    "appId": "com.rockiecraft.create-recipe-generator",
    "productName": "CreateRecipeGenerator",
    "files": [
      "app-entry.js",
      "src/**/*",
      "!src/**/*.map"
    ],
    "win": {
      "target": "portable",
      "icon": "src/main/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "flatpak"
      ],
      "icon": "src/main/assets/icon.png",
      "category": "Development"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk"
    }
  },
  "author": "Rockiecraft",
  "license": "MIT"
}