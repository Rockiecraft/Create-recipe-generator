{
  "name": "create-recipe-generator",
  "version": "0.0.2",
  "description": "Recipe Generator for the Create Mod",
  "main": "app-entry.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npx electron-builder --win portable",
    "build:linux": "npx electron-builder --linux AppImage",
    "dist": "npx electron-builder --win portable --linux AppImage"
  },
  "build": {
    "appId": "com.create_recipe_generator",
    "productName": "CreateRecipeGenerator",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "app-entry.js"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "author": "Rockiecraft",
  "license": "MIT"
}
